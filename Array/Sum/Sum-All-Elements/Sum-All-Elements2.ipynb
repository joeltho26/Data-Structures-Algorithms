   "source": [
    "def sum(numbers):\n",
    "    sum = 0\n",
    "    for i in numbers:\n",
    "        sum  += i\n",
    "    return sum\n",
    "    \n",
    "\n",
    "def main(numbers):\n",
    "    print(sum(numbers))"
   ]
  },
